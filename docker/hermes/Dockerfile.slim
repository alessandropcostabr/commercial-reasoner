# Agente Fase 1 - imagem ENXUTA do Hermes (sem Playwright/chromium, sem node UI).
# Baseada no Dockerfile oficial do hermes-agent, removendo o peso que a Agente
# de atendimento (Telegram, texto) nao usa. Build context = repo hermes-agent
# (o staging copia este arquivo para a raiz do repo como Dockerfile.slim).
#
# Removido vs. oficial: npm/nodejs, npx playwright install chromium, builds de
# web/ e ui-tui/, ffmpeg, docker-cli. Mantido: uv/python3.13, tini, git,
# ripgrep, curl + jq (necessarios para os hooks shell de memoria).
#
# Mantemos `uv sync --extra all --extra messaging` (set de deps de producao +
# adapters de gateway, Telegram incluso). Como NAO baixamos o chromium nem
# buildamos as UIs node, o grosso do tamanho ja sai.

FROM ghcr.io/astral-sh/uv:0.11.6-python3.13-trixie AS uv_source
FROM tianon/gosu:1.19-trixie AS gosu_source
FROM debian:13.4

ENV PYTHONUNBUFFERED=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential curl ca-certificates jq python3 ripgrep procps git openssh-client tini \
    gcc python3-dev libffi-dev && \
    rm -rf /var/lib/apt/lists/*

RUN useradd -u 10000 -m -d /opt/data hermes

COPY --chmod=0755 --from=gosu_source /gosu /usr/local/bin/
COPY --chmod=0755 --from=uv_source /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/

WORKDIR /opt/hermes

# Resolve deps Python primeiro (camada cacheada). README e referenciado pelo
# pyproject (readme=) mas excluido pelo .dockerignore - touch placeholder.
COPY pyproject.toml uv.lock ./
RUN touch ./README.md
RUN uv sync --frozen --no-install-project --extra all --extra messaging

# Fonte (sem node_modules, excluido pelo .dockerignore).
COPY --chown=hermes:hermes . .

# Permissoes: install dir legivel por qualquer HERMES_UID; .venv gravavel pelo
# hermes (lazy_deps instala adapters opcionais no 1o uso).
USER root
RUN chmod -R a+rX /opt/hermes && \
    chown -R hermes:hermes /opt/hermes/.venv

# Link editavel do proprio hermes-agent (rapido, --no-deps).
RUN uv pip install --no-cache-dir --no-deps -e "."

ENV HERMES_HOME=/opt/data
ENV PATH="/opt/data/.local/bin:${PATH}"
RUN mkdir -p /opt/data
VOLUME [ "/opt/data" ]

# entrypoint oficial do repo (faz usermod/gosu + bootstrap do /opt/data).
ENTRYPOINT [ "/usr/bin/tini", "-g", "--", "/opt/hermes/docker/entrypoint.sh" ]
CMD []
